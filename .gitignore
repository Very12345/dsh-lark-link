# dependencies
node_modules/

# Build output IS committed on purpose.
#
# pnpm refuses to run build scripts of git-hosted dependencies by default
# (ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED, a supply-chain guard). A git install
# therefore never runs `prepack`, so unless dist/ is in the repository the
# install fails or produces a package with no entry point.
#
# Committing dist/ makes `pnpm add <git-url>` work out of the box. Regenerate it
# with `npm run build` whenever src/ changes. See also .gitattributes.

# packaged tarballs
*.tgz

# logs & env
*.log
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# bridge runtime state (if ever created here)
.dsh/

# DSH credential stores — never commit. DSH keeps API keys and app secrets in
# these plaintext YAML documents under $DSH_HOME.
.credentials.yaml
.credentials.yaml.*
**/.credentials.yaml
**/.credentials.yaml.*

# research/ is private local material (surveys + cloned reference repos) — never published
research/
.playwright-mcp/

# ---------------------------------------------------------------------------
# Private deployment runbook: real hosts, SSH ports and absolute paths.
# Extracted from README.md so the public README carries no infrastructure data.
# ---------------------------------------------------------------------------
LOCAL-DEPLOYMENT.md

# ---------------------------------------------------------------------------
# Machine-specific ops scripts (two-host deploy, DSH upgrade/rollback, TUI
# profile wiring, cleanup chains). These reference real hosts and local
# layouts, so they stay local. Only upstream's dev-link.mjs + restart-dsh.sh
# and the environment-agnostic helpers under scripts/dev/ are published.
# ---------------------------------------------------------------------------
scripts/*.sh
!scripts/restart-dsh.sh
scripts/dsh-preview

# internal working notes / upstream issue drafts
.spec/
ISSUE-awesome-dsh-plugins.md
ISSUE-awesome-dsh-plugins.en.md

# ad-hoc local scratch scripts (vision/OCR probes, throwaway tools) — never publish
.vision.*.mjs
.*.tmp.mjs
.tmp*/

